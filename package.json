{
  "name": "agent-trust-kit",
  "version": "0.0.0",
  "description": "The trust layer for agents on the open agentic web: domain-signed networks, per-model behaviour attestations (in-toto, Sigstore Rekor), admit() for signed cross-site requests, and receipts that seal the person's mandate.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "canonicalize": "^4.0.0",
    "http-message-signatures": "^1.0.10",
    "jose": "^6.2.17"
  },
  "bin": {
    "trust-kit": "bin/trust-kit.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./network": "./src/network.js",
    "./attestation": "./src/attestation.js",
    "./keys": "./src/keys.js",
    "./canonical": "./src/canonical.js",
    "./http": "./src/http.js",
    "./dsse": "./src/dsse.js",
    "./peer": "./src/peer.js",
    "./peer-card": "./src/peer-card.js",
    "./rekor": "./src/rekor.js",
    "./admit": "./src/admit.js",
    "./model": "./src/model.js",
    "./verify-lite": "./src/verify-lite.js",
    "./receipt": "./src/receipt.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false
}
